# AWS Cognito Direct User Pool Authentication
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_ISSUER_URL=

# Optional Cognito Managed Login (Authorization Code + PKCE)
VITE_COGNITO_DOMAIN=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/login
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/login

# Optional explicit backend URLs (leave blank in dev to use Vite proxy on ports 8081..8085)
VITE_IAM_API_URL=
VITE_PROFILE_API_URL=
VITE_CLINICAL_API_URL=
VITE_TELEMETRY_API_URL=
VITE_ANALYTICS_API_URL=
